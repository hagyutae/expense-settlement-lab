{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "deny": ["Edit(tests/golden/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-state.py\"", "timeout": 120 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-registration.py\"", "timeout": 60 }
        ]
      }
    ]
  }
}
